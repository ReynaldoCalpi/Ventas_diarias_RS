services:
  - type: web
    name: ventas-diarias-rs
    env: python
    region: ohio # Puedes cambiarlo a la región que prefieras (ej: oregon, frankfurt)
    plan: free   # O 'starter' si usas disco persistente de pago
    buildCommand: pip install -r requirements.txt
    startCommand: streamlit run aplicacion.py --server.port $PORT --server.address 0.0.0.0
    disk:
      name: disco-ventas-historicas
      mountPath: /data
      sizeGB: 1
